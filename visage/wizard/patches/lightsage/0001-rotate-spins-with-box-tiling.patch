+    // Permute an axial-vector field (x, y, z components, if all present)
+    // as the tile's axis permutation does positions, with the sign the
+    // permutation's handedness gives (det = -1 for an odd permutation).
+    template <class U>
+    void _permute_axial_as(const char* nx, const char* ny, const char* nz, int ix, int iy, int iz,
+                           U sign)
+    {
+        auto X = _bat->template scalar<U>(nx);
+        auto Y = _bat->template scalar<U>(ny);
+        auto Z = _bat->template scalar<U>(nz);
+        for (unsigned ii = 0; ii < _bat->size(); ++ii)
+        {
+            U v[3] = {X[ii], Y[ii], Z[ii]};
+            X[ii] = sign * v[ix];
+            Y[ii] = sign * v[iy];
+            Z[ii] = sign * v[iz];
+        }
+    }
+
+    void _permute_axial(const char* nx, const char* ny, const char* nz, int ix, int iy, int iz)
+    {
+        if (!_bat->has_field(nx) || !_bat->has_field(ny) || !_bat->has_field(nz))
+            return;
+        // Parity of the permutation (ix, iy, iz) of (0, 1, 2).
+        int parity = (iy - ix) * (iz - ix) * (iz - iy);
+        switch (static_cast<tao::batch<real_type>::field_value_type>(_bat->get_field_type(nx)))
+        {
+        case tao::batch<real_type>::DOUBLE:
+            _permute_axial_as<double>(nx, ny, nz, ix, iy, iz, parity > 0 ? 1.0 : -1.0);
+            break;
+        case tao::batch<real_type>::FLOAT:
+            _permute_axial_as<float>(nx, ny, nz, ix, iy, iz, parity > 0 ? 1.0f : -1.0f);
+            break;
+        default:
+            break;
+        }
+    }
+
