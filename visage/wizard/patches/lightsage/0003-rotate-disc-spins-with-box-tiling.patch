+    // As above, for an axial vector held as one (n, 3) field.
+    template <class U>
+    void _permute_axial_vector_as(const char* name, int ix, int iy, int iz, U sign)
+    {
+        auto& m = _bat->template vector<U>(name);
+        for (unsigned ii = 0; ii < _bat->size(); ++ii)
+        {
+            U v[3] = {m(ii, 0), m(ii, 1), m(ii, 2)};
+            m(ii, 0) = sign * v[ix];
+            m(ii, 1) = sign * v[iy];
+            m(ii, 2) = sign * v[iz];
+        }
+    }
+
+    void _permute_axial_vector(const char* name, int ix, int iy, int iz)
+    {
+        if (!_bat->has_field(name))
+            return;
+        int parity = (iy - ix) * (iz - ix) * (iz - iy);
+        switch (static_cast<tao::batch<real_type>::field_value_type>(_bat->get_field_type(name)))
+        {
+        case tao::batch<real_type>::DOUBLE:
+            _permute_axial_vector_as<double>(name, ix, iy, iz, parity > 0 ? 1.0 : -1.0);
+            break;
+        case tao::batch<real_type>::FLOAT:
+            _permute_axial_vector_as<float>(name, ix, iy, iz, parity > 0 ? 1.0f : -1.0f);
+            break;
+        default:
+            break;
+        }
+    }
