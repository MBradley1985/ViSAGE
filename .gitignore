# Allow documentation images and static assets
!docs/images/*.png
!docs/images/*.jpg
!docs/images/*.jpeg
!docs/images/*.gif
!visage/static/*.jpg
!visage/static/*.jpeg
!visage/static/*.png
# Bundled Story Mode example stories (package data — must be committed)
!visage/examples/*.json
# Personal stories in sage_stories/ stay local (covered by *.json above);
# ship a story by adding it to visage/examples/ instead.
.pypirc

# Developer scripts (HD prototype, figure sheets, catalogue helper):
# local only, not part of ViSAGE.
scripts/
